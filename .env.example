# TimeGovern lab / Cloudflare Pages env example
# Copy to .env.local for local tests — never commit real IDs.

# Master switch for third-party ad scripts (must be exactly true)
VITE_ADS_ENABLED=false

# Google AdSense publisher client (ca-pub-...)
VITE_ADSENSE_CLIENT=

# Per-slot unit IDs from AdSense UI
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_RAIL=
VITE_ADSENSE_SLOT_INFEED=
VITE_ADSENSE_SLOT_FOOTER=
VITE_ADSENSE_SLOT_MREC=
VITE_ADSENSE_SLOT_ANCHOR=
